<p style="color: green"><%= notice %></p>

<%= render @category %>

<div>
  <%= link_to "Edit this category", edit_category_path(@category) %> |
  <%= link_to "Back to categories", categories_path %>

  <%= button_to "Destroy this category", @category, method: :delete %>
</div>

<div style="margin-top: 20px;">
  <h3>Cryptocurrencies in this Category</h3>
  <ul>
    <% @category.coins.each do |coin| %>
      <li><%= link_to coin.name, coin_path(coin) %> (<%= coin.symbol %>) - $<%= coin.current_price %></li>
    <% end %>
  </ul>
</div>

<p style="margin-top: 20px;">
  <%= link_to "Back to Categories", categories_path %>
</p>