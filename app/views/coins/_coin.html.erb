<div id="<%= dom_id coin %>">
  <p>
    <strong>Name:</strong>
    <%= coin.name %>
  </p>

  <p>
    <strong>Symbol:</strong>
    <%= coin.symbol %>
  </p>

  <p>
    <strong>Current price:</strong>
    <%= coin.current_price %>
  </p>

  <p>
    <strong>Market cap:</strong>
    <%= coin.market_cap %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= coin.category_id %>
  </p>

</div>
