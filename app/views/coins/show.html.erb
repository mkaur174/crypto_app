<p style="color: green"><%= notice %></p>

<%= render @coin %>

<div>
  <%= link_to "Edit this coin", edit_coin_path(@coin) %> |
  <%= link_to "Back to coins", coins_path %>

  <%= button_to "Destroy this coin", @coin, method: :delete %>
</div>
<p>
  <strong>Category:</strong>
  <%= link_to @coin.category.name, category_path(@coin.category) %>
</p>
